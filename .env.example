# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp (vd Gemini: gemini-3.8-flash).
# API_KEY: dán Gemini API key vào đây (codebase/ai.py đọc biến API_KEY).
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# MODEL_THINKING (tuỳ chọn, chỉ Gemini): mức suy nghĩ. gemini-3.8-flash nhận low (không nhận minimal);
# low giảm ~10 lần token ra so với mặc định mà vẫn ra đúng mã cảnh báo (thử 27/11). Để trống = mặc định của model.
MODEL_THINKING=

# Bot Zalo (tuỳ chọn, xem docs/zalo-bot.md)
ZALO_BOT_TOKEN=
ZALO_INVITE_CODE=
ZALO_ALLOWED_CHAT_IDS=
